# Server Configuration
PORT=4000
NODE_ENV=development

# Database (PostgreSQL)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/fedible_db
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=fedible_db
DB_POOL_MAX=20

# Cache (Redis)
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Security & JWT
JWT_SECRET=fedible_production_grade_super_secret_jwt_key_2026
JWT_EXPIRES_IN=7d
WEBHOOK_SECRET=whsec_fedible_fintech_secure_hmac_signing_key_9988

# Storage (FEFF)
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_BYTES=10485760

# AI Financial Assistant
GEMINI_API_KEY=
ENABLE_MOCK_AI=true

# Debug & Benchmarks
ENABLE_DEBUG_BENCHMARKS=true
